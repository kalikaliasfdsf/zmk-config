#include <dt-bindings/zmk/matrix_transform.h>

/ {
chosen {
zmk,kscan = <&kscan_composite>;
zmk,matrix_transform = <&default_transform>;
};

default_transform: keymap_transform_0 {
compatible = "zmk,matrix-transform";
columns = <16>;
rows = <6>;

map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
RC(5,6) RC(5,7)
>;
};

kscan0: kscan0 {
compatible = "zmk,kscan-gpio-matrix";
diode-direction = "col2row";
wakeup-source;

row-gpios
= <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
, <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
, <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
, <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
, <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
;
};

/* CHANGE THESE TWO FLAGS IF YOUR SWITCHES ARE WIRED TO VCC INSTEAD OF GND: */
/* Use (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) instead of (GPIO_ACTIVE_LOW | GPIO_PULL_UP) below */
kscan_direct: kscan_direct {
compatible = "zmk,kscan-gpio-direct";
wakeup-source;

input-gpios
= <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
, <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
;
};

kscan_composite: kscan_composite {
compatible = "zmk,kscan-composite";
rows = <6>;
columns = <16>;

matrix_child: matrix {
kscan = <&kscan0>;
};

/* CHANGE col-offset TO 8 IN THE RIGHT-SIDE OVERLAY IF YOU WIRE THAT SIDE TOO */
direct_child: direct {
kscan = <&kscan_direct>;
row-offset = <5>;
col-offset = <6>;
};
};
};
